   "outputs": [],
   "source": [
    "def forward_diff(y,h):\n",
    "    y = np.asarray(y, dtype=float)\n",
    "    return (y[1:] - y[:-1]) / h"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "2956ecf2",
   "metadata": {},
   "outputs": [],
   "source": [
    "def central_diff(y, h):\n",
    "    y = np.asarray(y, dtype=float)\n",
    "    return (y[2:] - y[:-2]) / (2 * h)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "942403aa",
   "metadata": {},
   "source": [
    "## Part 3\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "0b6e6af5",
   "metadata": {},
   "outputs": [],
   "source": [
    "def derivative_at(f, x, h, method, *args, **kwargs):\n",
    "    if method is forward_diff:\n",
    "        values = np.array([\n",
    "            f(x, *args, **kwargs),\n",
    "            f(x + h, *args, **kwargs)\n",
    "        ], dtype=float)\n",
    "        return method(values, h)[0]\n",
    "\n",
    "    values = np.array([\n",
    "        f(x - h, *args, **kwargs),\n",
    "        f(x, *args, **kwargs),\n",
    "        f(x + h, *args, **kwargs)\n",
    "    ], dtype=float)\n",
    "    return method(values, h)[0]\n",
    "\n"
   ]
  },
